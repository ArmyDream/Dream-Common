<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.dream</groupId>
        <artifactId>dream-common</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>dream-common-framework</artifactId>

    <description>
        框架基础设施层：缓存/Redis/过滤器/WebSocket/MVC 等技术支撑，不包含业务逻辑。
        依赖方向：framework → tool → core，被 security 等上层模块依赖。
    </description>

    <dependencies>
        <!-- 显式声明 core 依赖（存在直接 import，不能仅靠 tool 传递） -->
        <dependency>
            <groupId>com.dream</groupId>
            <artifactId>dream-common-core</artifactId>
        </dependency>

        <!-- 依赖 tool 模块 -->
        <dependency>
            <groupId>com.dream</groupId>
            <artifactId>dream-common-tool</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Hibernate Validator 字段验证-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP：支撑 @CacheDoubleDelete 等注解切面 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Redis：可选依赖，未引入也不会报错（相关 Bean 按 @ConditionalOnClass 条件装配） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Lettuce 连接池支持（可选），版本由 Spring Boot BOM 管理（2.7.18 → 2.11.1），不硬编码版本以保证与下游一致 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Redisson：分布式锁核心包（不使用 redisson-spring-boot-starter 以避免其自带的
             RedissonAutoConfiguration 注册 RedissonConnectionFactory 与 LettuceConnectionFactory 冲突） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Redisson Spring Data 2.7 适配（RedissonClient ↔ RedisTemplate 桥接，可选） -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-data-27</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Apache Commons Compress：支持 zip/tar/7z/gzip/bzip2/xz 等多种压缩格式（可选） -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- XZ for Java：commons-compress 处理 XZ/LZMA 格式时的可选依赖 -->
        <dependency>
            <groupId>org.tukaani</groupId>
            <artifactId>xz</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

</project>